# OpenAI — required.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Clerk — required for sign-in / cross-device sync.
# Get these from https://dashboard.clerk.com → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Custom auth pages (already implemented at /sign-in, /sign-up, /account).
# Setting these tells Clerk to route to our styled pages instead of hosted.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/chat
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/chat

# Supabase — required for cloud-stored conversations.
# Get these from your Supabase project → Settings → API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Sanity — required for the journal/blog.
# Create a project at https://sanity.io/manage. Add the Production dataset.
# In your project's API settings → CORS origins, allow your site origin
# (e.g. https://socria.vercel.app and http://localhost:3000).
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
