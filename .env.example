# OpenAI — required.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Clerk — required for sign-in / cross-device sync.
# Get these from https://dashboard.clerk.com → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Custom auth pages (already implemented at /sign-in, /sign-up, /account).
# Setting these tells Clerk to route to our styled pages instead of hosted.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/chat
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/chat

# Supabase — required for cloud-stored conversations.
# Get these from your Supabase project → Settings → API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Site — canonical domain used for metadata / OG / canonical URLs.
# Defaults to https://socria.app if unset.
NEXT_PUBLIC_SITE_URL=https://socria.app

# Sanity — required for the journal/blog.
# Create a project at https://sanity.io/manage. Add the Production dataset.
# In your project's API settings → CORS origins, allow your site origin
# (e.g. https://socria.app and http://localhost:3000).
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Rate limiting (OpenAI cost-abuse protection).
# Works out of the box with an in-memory limiter (per serverless instance).
# For production, set an Upstash Redis REST endpoint for accurate,
# cross-instance limits (https://upstash.com — free tier is enough):
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# Set RATE_LIMIT_DISABLED=1 to turn limiting off (local/testing only).

# Logos "explore" — web research behind a clicked node (optional).
# With neither set, Logos still produces the framing and question but shows
# no sources; it will not invent citations.
# Serper gives literal Google results (web + images):
# SERPER_API_KEY=...
# Or Tavily as an alternative:
# TAVILY_API_KEY=...

# Logos "Add context" — grounding map nodes in real material.
# Web, Paste and Upload always work with no setup. Google and Notion use a
# per-user OAuth "Connect" flow (read-only); set these to enable it.
#
# Required to store any connection (encrypts tokens at rest):
# CONNECTION_SECRET=a-long-random-string-at-least-16-chars
#
# Google OAuth app (one per deployment; users connect their own accounts):
#   Cloud Console -> APIs & Services -> Enable Drive, Sheets, Calendar, Gmail
#   -> Credentials -> OAuth client (Web). Add this redirect URI:
#     https://YOUR_SITE/api/logos/connect/google/callback
# GOOGLE_OAUTH_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=...
#
# Notion public OAuth integration (read content capability only):
#   notion.so/my-integrations -> new public integration. Redirect URI:
#     https://YOUR_SITE/api/logos/connect/notion/callback
# NOTION_OAUTH_CLIENT_ID=...
# NOTION_OAUTH_CLIENT_SECRET=...
#
# NEXT_PUBLIC_SITE_URL must be your canonical origin so the redirect URI matches.
#
# Legacy fallback (still honoured if set): a deployment-wide token instead of
# per-user OAuth — GOOGLE_ACCESS_TOKEN or GOOGLE_REFRESH_TOKEN(+client id/secret),
# and NOTION_API_KEY.

# ── Socria One (Stripe) ───────────────────────────────────────────────
# Billing for the $15/month subscription. Without these the tier still
# works via an access code, but nobody can actually subscribe.
STRIPE_SECRET_KEY=sk_test_...
# The recurring $15/month price. Create it in Stripe, then paste its id.
STRIPE_PRICE_SOCRIA_ONE=price_...
# From `stripe listen` locally, or the endpoint's signing secret in the
# dashboard. The webhook refuses every request without it.
STRIPE_WEBHOOK_SECRET=whsec_...
# Where Stripe returns people to. Falls back to the request origin.
NEXT_PUBLIC_SITE_URL=https://socria.com
# Comma-separated Clerk user ids that hold Socria One without billing
# (the team, support grants).
SOCRIA_ONE_USER_IDS=

# ── Connected sources (Drive/Docs/Calendar/Gmail/Notion) ─────────────
# OFF by default. Google's drive.readonly and gmail.readonly are RESTRICTED
# scopes: publishing them publicly requires a paid third-party security
# assessment, and until then only Cloud-Console test users can connect (with
# tokens that expire weekly). Socria ships with the connectors dormant so
# everyone gets the whole product for free.
#
# To turn them back on you need BOTH (server + client), and ideally a move to
# drive.file (picker-only, no verification) with Gmail dropped:
# SOCRIA_CONNECTORS=on
# NEXT_PUBLIC_SOCRIA_CONNECTORS=on
