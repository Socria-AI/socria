# OpenAI — required.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Clerk — required for sign-in / cross-device sync.
# Get these from https://dashboard.clerk.com → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Custom auth pages (already implemented at /sign-in, /sign-up, /account).
# Setting these tells Clerk to route to our styled pages instead of hosted.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/chat
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/chat

# Supabase — required for cloud-stored conversations.
# Get these from your Supabase project → Settings → API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Site — canonical domain used for metadata / OG / canonical URLs.
# Defaults to https://socria.app if unset.
NEXT_PUBLIC_SITE_URL=https://socria.app

# Sanity — required for the journal/blog.
# Create a project at https://sanity.io/manage. Add the Production dataset.
# In your project's API settings → CORS origins, allow your site origin
# (e.g. https://socria.app and http://localhost:3000).
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Rate limiting (OpenAI cost-abuse protection).
# Works out of the box with an in-memory limiter (per serverless instance).
# For production, set an Upstash Redis REST endpoint for accurate,
# cross-instance limits (https://upstash.com — free tier is enough):
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# Set RATE_LIMIT_DISABLED=1 to turn limiting off (local/testing only).

# Logos "explore" — web research behind a clicked node (optional).
# With neither set, Logos still produces the framing and question but shows
# no sources; it will not invent citations.
# Serper gives literal Google results (web + images):
# SERPER_API_KEY=...
# Or Tavily as an alternative:
# TAVILY_API_KEY=...

# Logos "Add context" — grounding map nodes in real material (all optional).
# Sources that aren't configured simply show as "not connected" in the picker;
# Web, Paste and Upload always work. Prototype auth model: one set of
# credentials per deployment, server-side only.
#
# Google (Drive, Docs, Sheets, Calendar, Gmail) — either a short-lived token
# for local testing:
# GOOGLE_ACCESS_TOKEN=ya29....
# ...or client credentials plus a refresh token (survives the hour):
# GOOGLE_OAUTH_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=...
# GOOGLE_REFRESH_TOKEN=...
# Scopes needed: drive.readonly, calendar.readonly, gmail.readonly.
#
# Notion — an internal integration token; share the relevant pages with it:
# NOTION_API_KEY=ntn_...
