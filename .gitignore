# NO TRAILING SLASH, and that is the whole point of this line.
#
# `node_modules/` matches a DIRECTORY. It does not match a symlink called
# node_modules — which is exactly what a git worktree gets when you point it at
# the real install to avoid a second one, and exactly what `git add -A` then
# committed into a merge: a 120000 entry pointing at an absolute path on one
# machine. Without the slash it matches either.
node_modules
.next/
out/
build/
*.log
.env
.env.local
.env*.local
.DS_Store
.vercel
*.tsbuildinfo

# Trailer build: the seeded canvas payload and the exported UI fragments are
# derived — regenerate them with .trailer/export.mjs + .trailer/build.mjs.
.trailer/socria-logos-trailer.html
.trailer/frag/
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Core 4 eval runs: pending model requests, cached completions and results
# are working state, regenerated by evals/core4/step.mjs. Summaries that
# matter are copied into docs/CORE-4-EVALS.md.
evals/core4/runs/
